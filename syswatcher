#!/bin/bash
set -euo pipefail

#######################################
# Paths
#######################################
CONFIG_FILE="/etc/syswatcher/config.conf"
STATE_DIR="/var/lib/syswatcher"
STATE_FILE="$STATE_DIR/last_alert"

#######################################
# Load config
#######################################
if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Config file not found: $CONFIG_FILE"
  exit 1
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

#######################################
# Validate config
#######################################
if [[ -z "${WEBHOOK_URL:-}" ]]; then
  exit 0
fi

mkdir -p "$STATE_DIR"

#######################################
# Cooldown check
#######################################
NOW=$(date +%s)
LAST_ALERT=0

if [[ -f "$STATE_FILE" ]]; then
  LAST_ALERT=$(cat "$STATE_FILE")
fi

if (( NOW - LAST_ALERT < COOLDOWN_SECONDS )); then
  exit 0
fi

#######################################
# CPU usage (percentage)
#######################################
read -r cpu user nice system idle iowait irq softirq steal _ < /proc/stat
TOTAL_1=$((user + nice + system + idle + iowait + irq + softirq + steal))
IDLE_1=$idle
sleep 1
read -r cpu user nice system idle iowait irq softirq steal _ < /proc/stat
TOTAL_2=$((user + nice + system + idle + iowait + irq + softirq + steal))
IDLE_2=$idle

CPU_USAGE=$(awk "BEGIN {printf \"%.2f\", (1 - ($IDLE_2 - $IDLE_1)/($TOTAL_2 - $TOTAL_1)) * 100}")
CPU_USAGE_INT=${CPU_USAGE%.*}

#######################################
# RAM usage
#######################################
RAM_USAGE=$(free | awk '/Mem:/ { printf "%.0f", $3/$2 * 100 }')

#######################################
# Disk usage
#######################################
DISK_USAGE=$(df -P "$DISK_PATH" | awk 'NR==2 {gsub("%",""); print $5}')

#######################################
# Threshold checks
#######################################
ALERTS=()

if (( CPU_USAGE_INT >= CPU_THRESHOLD )); then
  ALERTS+=("CPU Usage   : ${CPU_USAGE}%")
fi

if (( RAM_USAGE >= RAM_THRESHOLD )); then
  ALERTS+=("Memory Usage: ${RAM_USAGE}%")
fi

if (( DISK_USAGE >= DISK_THRESHOLD )); then
  ALERTS+=("Disk Usage  : ${DISK_USAGE}% (${DISK_PATH})")
fi

#######################################
# Exit if nothing breached
#######################################
if [[ ${#ALERTS[@]} -eq 0 ]]; then
  exit 0
fi

#######################################
# Alert message
#######################################
HOST="${HOSTNAME_OVERRIDE:-$(hostname)}"
TIMESTAMP=$(date -u +"%Y-%m-%d %H:%M UTC")

MESSAGE="🚨 *System Resource Alert*

*Host:* ${HOST}
*Timestamp:* ${TIMESTAMP}

"

for a in "${ALERTS[@]}"; do
  MESSAGE+="$a
"
done

#######################################
# Send alert
#######################################
curl -s -X POST \
  -H "Content-Type: application/json" \
  -d "{\"text\":\"$MESSAGE\"}" \
  "$WEBHOOK_URL" >/dev/null

#######################################
# Update cooldown timestamp
#######################################
echo "$NOW" > "$STATE_FILE"