#!/bin/bash
set -euo pipefail

CONFIG_FILE="/etc/syswatcher/config.conf"
STATE_DIR="/var/lib/syswatcher"
STATE_FILE="$STATE_DIR/last_alert"
LOCK_FILE="/run/syswatcher.lock"
LOG_TAG="syswatcher"

log() {
  logger -t "$LOG_TAG" "$1"
}

[[ -f "$CONFIG_FILE" ]] || exit 0
mkdir -p "$STATE_DIR"

exec 9>"$LOCK_FILE" || true
if ! flock -n 9; then
  exit 0
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"

for v in CPU_THRESHOLD RAM_THRESHOLD DISK_THRESHOLD DISK_PATH WEBHOOK_URL COOLDOWN_SECONDS; do
  [[ -n "${!v:-}" ]] || exit 0
done

NOW=$(date +%s)

if [[ -f "$STATE_FILE" ]]; then
  LAST=$(cat "$STATE_FILE" || echo 0)
  (( NOW - LAST < COOLDOWN_SECONDS )) && exit 0
fi

read -r _ u n s i iw irq sirq st < /proc/stat
t1=$((u+n+s+i+iw+irq+sirq+st)); i1=$i
sleep 1
read -r _ u n s i iw irq sirq st < /proc/stat
t2=$((u+n+s+i+iw+irq+sirq+st)); i2=$i

CPU=$(( ((t2-t1)-(i2-i1)) * 100 / (t2-t1) ))
RAM=$(free | awk '/Mem:/ {printf "%.0f", $3/$2*100}')
DISK=$(df -P "$DISK_PATH" | awk 'NR==2 {gsub("%",""); print $5}')

ALERTS=()
[[ $CPU  -ge $CPU_THRESHOLD  ]] && ALERTS+=("CPU: ${CPU}%")
[[ $RAM  -ge $RAM_THRESHOLD  ]] && ALERTS+=("RAM: ${RAM}%")
[[ $DISK -ge $DISK_THRESHOLD ]] && ALERTS+=("Disk ($DISK_PATH): ${DISK}%")

if [[ ${#ALERTS[@]} -gt 0 ]]; then
  HOST="${HOSTNAME_OVERRIDE:-$(hostname)}"
  MESSAGE="Resource Alert on $HOST\n$(printf '%s\n' "${ALERTS[@]}")"

  ESCAPED_MESSAGE=$(printf '%s' "$MESSAGE" | sed 's/\\/\\\\/g; s/"/\\"/g')
  JSON="{\"text\":\"$ESCAPED_MESSAGE\"}"

  curl -fsS -X POST \
    -H "Content-Type: application/json" \
    -d "$JSON" \
    "$WEBHOOK_URL" >/dev/null || {
      log "Failed to send alert"
      exit 0
    }

  echo "$NOW" > "$STATE_FILE"
  log "Alert sent"
fi